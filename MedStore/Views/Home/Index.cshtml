@model MedStore.Models.DashboardViewModel
@{ ViewData["Title"]="Dashboard"; }
<div class="welcome-row"><div><h2>Good day, @User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value?.Split(' ').FirstOrDefault() 👋</h2><p>Here’s your store overview for today.</p></div><a class="button button-primary" asp-controller="Medicines" asp-action="Create">＋ Add medicine</a></div>
<section class="stats-grid">
<article class="stat-card"><div class="stat-label">TOTAL MEDICINES <span class="stat-icon teal">▦</span></div><strong>@Model.Medicines.ToString("N0")</strong><small>Active inventory items</small></article><article class="stat-card"><div class="stat-label">TODAY’S SALES <span class="stat-icon green">↗</span></div><strong>₹@Model.TodaySales.ToString("N2")</strong><small>Completed transactions</small></article><article class="stat-card"><div class="stat-label">MONTH REVENUE <span class="stat-icon blue">◷</span></div><strong>₹@Model.MonthRevenue.ToString("N2")</strong><small>Current month</small></article><article class="stat-card"><div class="stat-label">INVENTORY VALUE <span class="stat-icon purple">◇</span></div><strong>₹@Model.InventoryValue.ToString("N0")</strong><small>At purchase cost</small></article>
<article class="stat-card"><div class="stat-label">CATEGORIES <span class="stat-icon teal">▤</span></div><strong>@Model.Categories</strong><small>Medicine groups</small></article><article class="stat-card"><div class="stat-label">SUPPLIERS <span class="stat-icon blue">♧</span></div><strong>@Model.Suppliers</strong><small>Registered partners</small></article><article class="stat-card"><div class="stat-label">CUSTOMERS <span class="stat-icon green">♙</span></div><strong>@Model.Customers</strong><small>Registered customers</small></article><article class="stat-card"><div class="stat-label">EMPLOYEES <span class="stat-icon purple">♙</span></div><strong>@Model.Employees</strong><small>Active workforce</small></article></section>
@{var maxSales=Model.SalesLast7Days.Count==0?1m:Math.Max(1m,Model.SalesLast7Days.Max(x=>x.Amount));}<section class="panel sales-chart-panel"><div class="panel-head"><div><h3>Sales · last 7 days</h3><p>Completed invoice totals by day</p></div><strong>₹@Model.TodaySales.ToString("N2") today</strong></div><div class="sales-bars">@foreach(var day in Model.SalesLast7Days){<div class="sales-bar-column"><strong>₹@day.Amount.ToString("N0")</strong><div class="sales-bar" style="height:@(Math.Max(5,(double)(day.Amount/maxSales)*112))px"></div><small>@day.Date.ToString("ddd")</small></div>}</div></section>
<div class="dashboard-lower"><section class="panel alerts-panel"><div class="panel-head"><div><h3>Inventory attention</h3><p>Low stock and upcoming expiry</p></div><a asp-controller="Medicines" asp-action="Index">View inventory →</a></div><div class="alert-summary"><div><b class="warning-text">@Model.LowStock</b><span>Low stock</span></div><div><b class="danger-text">@Model.Expired</b><span>Expired</span></div></div>@if(Model.Alerts.Count==0){<div class="empty-state"><span>✓</span><strong>Everything looks good</strong><p>No items need attention right now.</p></div>}else{<div class="table-wrap"><table><thead><tr><th>MEDICINE</th><th>BATCH</th><th>QUANTITY</th><th>EXPIRY</th><th>STATUS</th></tr></thead><tbody>@foreach(var item in Model.Alerts){<tr><td><strong>@item.Name</strong><small>@item.CategoryName</small></td><td>@item.BatchNumber</td><td>@item.Quantity</td><td>@item.ExpiryDate.ToString("dd MMM yyyy")</td><td><span class="badge @(item.ExpiryDate.Date<DateTime.Today?"badge-red":item.Quantity<=10?"badge-amber":"badge-blue")">@(item.ExpiryDate.Date<DateTime.Today?"Expired":item.Quantity<=10?"Low stock":"Expiring soon")</span></td></tr>}</tbody></table></div>}</section><section class="panel quick-panel"><div class="panel-head"><div><h3>Quick actions</h3><p>Common store tasks</p></div></div><a class="quick-action" asp-controller="Medicines" asp-action="Create"><span class="quick-icon teal">＋</span><span><strong>Add a medicine</strong><small>Register a new medicine batch</small></span><b>→</b></a><a class="quick-action" asp-controller="Transactions" asp-action="Index" asp-route-kind="purchase"><span class="quick-icon blue">⇄</span><span><strong>Record a purchase</strong><small>Restock from a supplier</small></span><b>→</b></a><a class="quick-action" asp-controller="Transactions" asp-action="Index" asp-route-kind="sale"><span class="quick-icon green">▣</span><span><strong>Start a sale</strong><small>Create a customer invoice</small></span><b>→</b></a><a class="quick-action" asp-controller="Reports" asp-action="Index"><span class="quick-icon purple">↗</span><span><strong>View reports</strong><small>Sales and inventory insights</small></span><b>→</b></a></section></div><section class="panel recent-sales"><div class="panel-head"><div><h3>Recent sales</h3><p>Latest completed invoices</p></div><a asp-controller="Transactions" asp-action="Index" asp-route-kind="sale">Sales history →</a></div><div class="table-wrap"><table><thead><tr><th>INVOICE</th><th>CUSTOMER</th><th>ITEMS</th><th>DATE</th><th>TOTAL</th></tr></thead><tbody>@foreach(var sale in Model.RecentSales){<tr><td>@sale.InvoiceNumber</td><td>@sale.PartnerName</td><td>@sale.Lines.Count</td><td>@sale.Date.ToString("dd MMM HH:mm")</td><td>₹@sale.Total.ToString("N2")</td></tr>}@if(Model.RecentSales.Count==0){<tr><td colspan="5" class="empty-table">Recent sales will appear here.</td></tr>}</tbody></table></div></section>
