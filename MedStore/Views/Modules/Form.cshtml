@model MedStore.Models.ModuleFormViewModel
@{ViewData["Title"]=(Model.Record.Id==0?"Add · ":"Edit · ")+Model.Title;string FieldValue(string key)=>key switch{"Name"=>Model.Record.Name,"Contact"=>Model.Record.Contact??"","Email"=>Model.Record.Email??"","Username"=>Model.Record.Username??"","Address"=>Model.Record.Address??"","Company"=>Model.Record.Company??"","Designation"=>Model.Record.Designation??"","Amount"=>Model.Record.Amount.ToString(System.Globalization.CultureInfo.InvariantCulture),"Allowances"=>Model.Record.Allowances.ToString(System.Globalization.CultureInfo.InvariantCulture),"Deductions"=>Model.Record.Deductions.ToString(System.Globalization.CultureInfo.InvariantCulture),"Date"=>Model.Record.Date.ToString("yyyy-MM-dd"),"StartDate"=>Model.Record.StartDate.ToString("yyyy-MM-dd"),"EndDate"=>Model.Record.EndDate.ToString("yyyy-MM-dd"),"Category"=>Model.Record.Category??"","Description"=>Model.Key=="users"?"":Model.Record.Description??"","Rating"=>Model.Record.Rating.ToString(),_=>""};}
<div class="welcome-row"><div><h2>@ViewData["Title"]</h2><p>Complete the details below and save.</p></div><a class="button button-light" asp-action="Index" asp-route-module="@Model.Key">← Back</a></div><section class="panel form-panel"><form asp-action="Save" asp-route-module="@Model.Key" method="post"><input type="hidden" name="Id" value="@Model.Record.Id"/><div asp-validation-summary="ModelOnly" class="form-error"></div><div class="form-grid">@foreach(var field in Model.Fields){<div><label for="@field.Key">@field.Label</label>@if(field.Key=="Role"){<select name="Role" id="Role"><option selected="@(Model.Record.Role=="Admin")">Admin</option><option selected="@(Model.Record.Role=="Pharmacist")">Pharmacist</option><option selected="@(Model.Record.Role=="Billing Staff")">Billing Staff</option></select>}else{<input name="@field.Key" id="@field.Key" type="@field.Type" value="@FieldValue(field.Key)" required="@(field.Required?"required":null)" max="@(field.Key=="Rating"?"5":null)" step="@(field.Key is "Amount" or "Allowances" or "Deductions"?"0.01":null)" min="@(field.Key is "Amount" or "Allowances" or "Deductions"?"0":field.Key=="Rating"?"1":null)" placeholder="@(field.Key=="Description"&&Model.Key=="users"?"Leave blank to keep the current password":"")"/>}</div>}@if(Model.Key=="users"&&Model.Record.Id>0){<div><label for="Status">Account status</label><select name="Status" id="Status"><option selected="@(Model.Record.Status=="Active")">Active</option><option selected="@(Model.Record.Status=="Inactive")">Inactive</option></select></div>}</div><div class="form-actions"><a class="button button-light" asp-action="Index" asp-route-module="@Model.Key">Cancel</a><button class="button button-primary">Save</button></div>@Html.AntiForgeryToken()</form></section>
