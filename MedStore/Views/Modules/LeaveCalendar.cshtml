@model MedStore.Models.LeaveCalendarViewModel
@{ViewData["Title"]="Employee leave calendar";}
<div class="welcome-row"><div><h2>Employee leave calendar</h2><p>Approved and pending leave applications by day.</p></div><a class="button button-light" asp-action="Index" asp-route-module="leaves">← Leave requests</a></div><section class="panel"><form method="get" class="calendar-month-form"><label for="month">Calendar month</label><input id="month" name="month" type="month" value="@Model.Month.ToString("yyyy-MM")"/><button class="button button-primary">Show month</button></form><div class="leave-calendar"><div class="calendar-day-heading">Sun</div><div class="calendar-day-heading">Mon</div><div class="calendar-day-heading">Tue</div><div class="calendar-day-heading">Wed</div><div class="calendar-day-heading">Thu</div><div class="calendar-day-heading">Fri</div><div class="calendar-day-heading">Sat</div>@foreach(var day in Model.Days){var leaveItems=Model.Leaves.Where(l=>l.StartDate.Date<=day.Date&&l.EndDate.Date>=day.Date).ToList();<div class="calendar-cell @(day.Month==Model.Month.Month?"":"outside-month")"><strong>@day.Day</strong>@foreach(var leave in leaveItems){<span class="calendar-leave @(leave.Status=="Approved"?"approved":leave.Status=="Rejected"?"rejected":"pending")" title="@leave.Description">@leave.Name · @leave.Status</span>}</div>}</div></section>
