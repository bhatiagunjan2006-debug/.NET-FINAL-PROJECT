@model MedStore.Models.BusinessRecord
@{ViewData["Title"]="Salary slip · "+Model.Name;}
<div class="welcome-row no-print"><div><h2>Salary slip</h2><p>@Model.Name · @Model.Date.ToString("MMMM yyyy")</p></div><button class="button button-primary" onclick="window.print()">Print salary slip</button></div><article class="invoice-sheet"><header class="invoice-header"><div><div class="invoice-brand">MediStock · Salary statement</div><p>Confidential employee payroll record</p></div><div class="invoice-meta"><span>PAY PERIOD</span><strong>@Model.Date.ToString("MMMM yyyy")</strong><small>@Model.Status</small></div></header><div class="invoice-partner"><div><small>EMPLOYEE</small><strong>@Model.Name</strong></div><div><small>PAY DATE</small><strong>@Model.Date.ToString("dd MMM yyyy")</strong></div></div><div class="salary-lines"><div><span>Basic salary</span><strong>@Model.Description?.Split(';').FirstOrDefault(x=>x.Contains("Basic"))</strong></div><div><span>Allowances</span><strong>₹@Model.Allowances.ToString("N2")</strong></div><div><span>Deductions</span><strong>− ₹@Model.Deductions.ToString("N2")</strong></div><div class="invoice-grand"><span>Net salary</span><strong>₹@Model.Amount.ToString("N2")</strong></div></div><footer class="invoice-footer">Generated by MediStock Employee Payroll</footer></article>
