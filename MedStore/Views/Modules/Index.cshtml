@model MedStore.Models.ModulePageViewModel
@{ViewData["Title"]=Model.Title;}
<div class="welcome-row"><div><h2>@Model.Title</h2><p>@Model.Description</p></div><div class="welcome-actions">@if(Model.Key=="leaves"){<a class="button button-light" asp-action="LeaveCalendar">View calendar</a>}@if(Model.Key!="payroll"){<a class="button button-primary" asp-action="Create" asp-route-module="@Model.Key">＋ Add record</a>}</div></div>
@if(TempData["Notice"] is string n){<div class="notice">✓ @n</div>}@if(TempData["Error"] is string e){<div class="form-error notice-error">@e</div>}
@if(Model.Key=="payroll"){<section class="panel payroll-generate"><div><h3>Generate monthly payroll</h3><p>Creates one salary record per active employee for the selected month.</p></div><form asp-action="GeneratePayroll" method="post"><input type="month" name="period" value="@DateTime.Today.ToString("yyyy-MM")"/><button class="button button-primary">Generate payroll</button>@Html.AntiForgeryToken()</form></section>}
<section class="panel"><div class="panel-head"><div><h3>@(Model.Key=="payroll"?"Payroll history":"Records")</h3><p>@Model.Rows.Count entries</p></div><form method="get" class="search-form"><input name="q" placeholder="Search records…"/><button class="button button-light">Search</button></form></div><div class="table-wrap"><table><thead><tr><th>NAME</th><th>DETAILS</th><th>AMOUNT / RATING</th><th>DATE / STATUS</th><th>ACTIONS</th></tr></thead><tbody>@foreach(var r in Model.Rows){<tr><td><strong>@r.Name</strong><small>@r.Designation</small></td><td>@if(Model.Key=="suppliers"||Model.Key=="customers"){<a asp-controller="Transactions" asp-action="Index" asp-route-kind="@(Model.Key=="suppliers"?"purchase":"sale")" asp-route-q="@r.Name">View history →</a>}else{@(r.Company??r.Contact??r.Category??r.Description??r.Email??r.Username??"—")}</td><td>@(r.Category=="Salary slip"?r.Amount.ToString("C"):r.Amount>0?r.Amount.ToString("C"):r.Rating>0?($"★ {r.Rating}/5"):"—")</td><td>@(r.Status=="Pending"?r.Status:r.Date.ToString("dd MMM yyyy")) <span class="badge @(r.Status=="Approved"||r.Status=="Paid"?"badge-green":r.Status=="Rejected"?"badge-red":r.Status=="Pending"?"badge-amber":"badge-blue")">@r.Status</span></td><td class="row-actions">@if(Model.Key=="leaves"&&r.Status=="Pending"&&User.IsInRole("Admin")){<form asp-action="ReviewLeave" asp-route-id="@r.Id" method="post"><input type="hidden" name="decision" value="Approved"/><button>Approve</button>@Html.AntiForgeryToken()</form><form asp-action="ReviewLeave" asp-route-id="@r.Id" method="post"><input type="hidden" name="decision" value="Rejected"/><button class="danger-link">Reject</button>@Html.AntiForgeryToken()</form>}else if(Model.Key=="payroll"){<a asp-action="PayrollSlip" asp-route-id="@r.Id">Print slip</a>}else{<a asp-action="Edit" asp-route-module="@Model.Key" asp-route-id="@r.Id">Edit</a><form asp-action="Delete" asp-route-module="@Model.Key" asp-route-id="@r.Id" method="post" onsubmit="return confirm('Delete this record?')"><button class="danger-link">Delete</button>@Html.AntiForgeryToken()</form>}</td></tr>}@if(Model.Rows.Count==0){<tr><td colspan="5" class="empty-table">No records yet.</td></tr>}</tbody></table></div></section>
