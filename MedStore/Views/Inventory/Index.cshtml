@{ViewData["Title"]="Inventory management";var meds=(List<MedStore.Models.Medicine>)ViewBag.Medicines;var moves=(List<MedStore.Models.MovementRecord>)ViewBag.Movements;}
<div class="welcome-row"><div><h2>Stock control</h2><p>Batch-level inventory, adjustments, and movement history.</p></div></div>@if(TempData["Notice"] is string n){<div class="notice">✓ @n</div>}@if(TempData["Error"] is string e){<div class="form-error notice-error">@e</div>}
@if(User.IsInRole("Admin")||User.IsInRole("Pharmacist")){<section class="panel stock-adjust-panel"><div class="panel-head"><div><h3>Adjust stock</h3><p>Use a positive number to add units or a negative number to remove units.</p></div></div><form asp-action="Adjust" method="post" class="stock-adjust-form"><select name="MedicineId" required><option value="">Select batch</option>@foreach(var m in meds){<option value="@m.Id">@m.Name · @m.BatchNumber · currently @m.Quantity</option>}</select><input type="number" name="Change" placeholder="e.g. 5 or -2" required/><input type="text" name="Note" placeholder="Reason for adjustment" required/><button class="button button-primary">Save adjustment</button>@Html.AntiForgeryToken()</form></section>}
<section class="panel"><div class="panel-head"><div><h3>Batch stock</h3><p>@meds.Count batches · value ₹@meds.Sum(m=>m.Quantity*m.PurchasePrice).ToString("N2")</p></div><a asp-controller="Medicines" asp-action="Index">Manage medicines →</a></div><div class="table-wrap"><table><thead><tr><th>MEDICINE</th><th>BATCH</th><th>QUANTITY</th><th>PURCHASE VALUE</th><th>EXPIRY</th><th>STATUS</th></tr></thead><tbody>@foreach(var m in meds){<tr><td><strong>@m.Name</strong><small>@m.CategoryName</small></td><td>@m.BatchNumber</td><td>@m.Quantity</td><td>₹@((m.Quantity*m.PurchasePrice).ToString("N2"))</td><td>@m.ExpiryDate.ToString("dd MMM yyyy")</td><td><span class="badge @(m.ExpiryDate.Date<DateTime.Today?"badge-red":m.Quantity<=10?"badge-amber":"badge-green")">@(m.ExpiryDate.Date<DateTime.Today?"Expired":m.Quantity<=10?"Low stock":"In stock")</span></td></tr>}</tbody></table></div></section>
<section class="panel transaction-history"><div class="panel-head"><div><h3>Stock movement history</h3><p>Purchases, sales, reversals, and adjustments</p></div></div><div class="table-wrap"><table><thead><tr><th>DATE</th><th>MEDICINE</th><th>TYPE</th><th>CHANGE</th><th>REFERENCE / NOTE</th></tr></thead><tbody>@foreach(var m in moves){<tr><td>@m.Date.ToString("dd MMM yyyy HH:mm")</td><td>@m.MedicineName</td><td>@m.Type</td><td class="@(m.Change<0?"danger-text":"")">@(m.Change>0?"+":"")@m.Change</td><td>@m.Note</td></tr>}@if(moves.Count==0){<tr><td colspan="5" class="empty-table">Stock movements appear here as you record purchases and sales.</td></tr>}</tbody></table></div></section>
