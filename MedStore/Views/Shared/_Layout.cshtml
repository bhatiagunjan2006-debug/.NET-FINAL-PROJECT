@{ var auth = User.Identity?.IsAuthenticated == true; var pageTitle = ViewData["Title"]?.ToString() ?? "Dashboard"; var name = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? "User"; var controller = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "home").ToLowerInvariant(); var action = (ViewContext.RouteData.Values["action"]?.ToString() ?? "index").ToLowerInvariant(); var module = ViewContext.RouteData.Values["module"]?.ToString()?.ToLowerInvariant() ?? (action.Contains("payroll")?"payroll":action.Contains("leave")?"leaves":"categories"); var kind = ViewContext.RouteData.Values["kind"]?.ToString()?.ToLowerInvariant(); var pageKey = controller=="modules"?module:controller=="transactions"?"transactions-"+(kind??"sale"):controller; }
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@pageTitle · MediStock</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body class="@(auth?"app-shell":"auth-shell")" data-page="@pageKey">
@if(auth){
<aside class="sidebar"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-icon">✚</span><span>Medi<span class="brand-accent">Stock</span><small>STORE OPERATIONS</small></span></a>
<div class="nav-label">WORKSPACE</div><a class="nav-item" asp-controller="Home" asp-action="Index">◫ <span>Dashboard</span></a>
<div class="nav-label">INVENTORY</div><a class="nav-item" asp-controller="Medicines" asp-action="Index">▦ <span>Medicine management</span></a>@if(User.IsInRole("Admin")||User.IsInRole("Pharmacist")){<a class="nav-item" asp-controller="Modules" asp-action="Index" asp-route-module="categories">◈ <span>Categories</span></a><a class="nav-item" asp-controller="Modules" asp-action="Index" asp-route-module="suppliers">♧ <span>Suppliers</span></a><a class="nav-item" asp-controller="Transactions" asp-action="Index" asp-route-kind="purchase">⇄ <span>Purchases</span></a>}<a class="nav-item" asp-controller="Modules" asp-action="Index" asp-route-module="customers">♙ <span>Customers</span></a><a class="nav-item" asp-controller="Transactions" asp-action="Index" asp-route-kind="sale">▣ <span>Sales &amp; billing</span></a><a class="nav-item" asp-controller="Inventory" asp-action="Index">▤ <span>Stock movement</span></a>
<div class="nav-label">PEOPLE &amp; INSIGHTS</div>@if(User.IsInRole("Admin")){<a class="nav-item" asp-controller="Modules" asp-action="Index" asp-route-module="employees">♙ <span>Employees</span></a><a class="nav-item" asp-controller="Modules" asp-action="Index" asp-route-module="payroll">₹ <span>Employee payroll</span></a>}<a class="nav-item" asp-controller="Modules" asp-action="Index" asp-route-module="leaves">◷ <span>Leave management</span></a>@if(User.IsInRole("Admin")){<a class="nav-item" asp-controller="Modules" asp-action="Index" asp-route-module="expenses">◉ <span>Expenses</span></a>}@if(User.IsInRole("Admin")||User.IsInRole("Pharmacist")){<a class="nav-item" asp-controller="Modules" asp-action="Index" asp-route-module="feedback">☆ <span>Feedback</span></a>}@if(User.IsInRole("Admin")||User.IsInRole("Pharmacist")){<a class="nav-item" asp-controller="Reports" asp-action="Index">↗ <span>Reports</span></a>}@if(User.IsInRole("Admin")){<a class="nav-item" asp-controller="Modules" asp-action="Index" asp-route-module="users">♧ <span>User management</span></a><a class="nav-item" asp-controller="Modules" asp-action="Index" asp-route-module="settings">⚙ <span>Settings</span></a>}
<div class="sidebar-bottom"><div class="user-avatar">@name.FirstOrDefault()</div><div class="user-copy"><strong>@name</strong><span>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span></div><form asp-controller="Account" asp-action="Logout" method="post"><button class="logout" title="Logout">↪</button></form></div></aside>
<main class="main-area"><header class="topbar"><div><div class="eyebrow">MEDISTOCK / @pageTitle.ToUpperInvariant()</div><h1>@pageTitle</h1></div><div class="top-right"><span class="status-dot"></span><span>Store operational</span><span class="top-divider"></span><span>@DateTime.Now.ToString("ddd, dd MMM yyyy")</span><span class="top-avatar">@name.FirstOrDefault()</span></div></header><div class="content">@RenderBody()</div></main>
}else{@RenderBody()}
<script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
