@{ViewData["Title"]="Reports & analytics";var d=(MedStore.Models.DashboardViewModel)ViewBag.Dashboard;var sales=(List<MedStore.Models.StoreTransaction>)ViewBag.Sales;}
<div class="welcome-row"><div><h2>Reports &amp; analytics</h2><p>Current business totals and transaction history.</p></div><button class="button button-light" onclick="window.print()">Print report</button></div><section class="stats-grid"><article class="stat-card"><div class="stat-label">MONTH REVENUE</div><strong>₹@d.MonthRevenue.ToString("N2")</strong><small>Completed sales this month</small></article><article class="stat-card"><div class="stat-label">TODAY’S SALES</div><strong>₹@d.TodaySales.ToString("N2")</strong><small>Completed today</small></article><article class="stat-card"><div class="stat-label">INVENTORY VALUE</div><strong>₹@d.InventoryValue.ToString("N2")</strong><small>At purchase cost</small></article><article class="stat-card"><div class="stat-label">LOW STOCK</div><strong>@d.LowStock</strong><small>Batches with 10 units or fewer</small></article></section><section class="panel transaction-history"><div class="panel-head"><div><h3>Sales register</h3><p>@sales.Count invoices</p></div></div><div class="table-wrap"><table><thead><tr><th>INVOICE</th><th>DATE</th><th>CUSTOMER</th><th>ITEMS</th><th>DISCOUNT</th><th>TOTAL</th><th>STATUS</th></tr></thead><tbody>@foreach(var s in sales){<tr><td>@s.InvoiceNumber</td><td>@s.Date.ToString("dd MMM yyyy HH:mm")</td><td>@s.PartnerName</td><td>@string.Join(", ",s.Lines.Select(l=>$"{l.MedicineName} × {l.Quantity}"))</td><td>₹@s.Discount.ToString("N2")</td><td>₹@s.Total.ToString("N2")</td><td>@s.Status</td></tr>}@if(sales.Count==0){<tr><td colspan="7" class="empty-table">No sales recorded yet.</td></tr>}</tbody></table></div></section>
