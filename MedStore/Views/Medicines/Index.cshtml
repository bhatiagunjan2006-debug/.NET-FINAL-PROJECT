@model MedStore.Models.MedicineListViewModel
@{ViewData["Title"]="Medicine management";}
<div class="welcome-row"><div><h2>Medicine inventory</h2><p>Search and manage batches, pricing, and expiry information.</p></div>@if(User.IsInRole("Admin")||User.IsInRole("Pharmacist")){<a class="button button-primary" asp-action="Create">＋ Add medicine</a>}</div>@if(TempData["Notice"] is string n){<div class="notice">✓ @n</div>}@if(TempData["Error"] is string e){<div class="form-error notice-error">@e</div>}
<section class="panel"><form method="get" class="inventory-filters"><input name="q" value="@Model.Search" placeholder="Search medicine or batch"/><select name="categoryId"><option value="">All categories</option>@foreach(var c in Model.Categories){<option value="@c.Id" selected="@(Model.CategoryId==c.Id)">@c.Name</option>}</select><input name="manufacturer" value="@Model.Manufacturer" placeholder="Manufacturer"/><input name="expiryBefore" type="date" value="@(Model.ExpiryBefore?.ToString("yyyy-MM-dd"))" title="Expiring before"/><select name="sort"><option value="name" selected="@(Model.Sort=="name")">Sort: Name</option><option value="expiry" selected="@(Model.Sort=="expiry")">Sort: Expiry</option><option value="quantity" selected="@(Model.Sort=="quantity")">Sort: Quantity</option><option value="price" selected="@(Model.Sort=="price")">Sort: Price</option></select><button class="button button-primary">Filter</button><a class="button button-light" asp-action="Export" asp-route-q="@Model.Search" asp-route-categoryId="@Model.CategoryId" asp-route-manufacturer="@Model.Manufacturer" asp-route-expiryBefore="@Model.ExpiryBefore?.ToString("yyyy-MM-dd")" asp-route-sort="@Model.Sort">Export CSV</a></form><div class="panel-head inventory-heading"><div><h3>All medicine batches</h3><p>@Model.TotalCount records · page @Model.Page of @Model.TotalPages</p></div></div><div class="table-wrap"><table><thead><tr><th>MEDICINE</th><th>CATEGORY</th><th>BATCH</th><th>PRICE</th><th>STOCK</th><th>EXPIRY</th><th>STATUS</th><th></th></tr></thead><tbody>@foreach(var m in Model.Items){<tr><td><strong>@m.Name</strong><small>@m.Manufacturer</small></td><td>@m.CategoryName</td><td>@m.BatchNumber</td><td>₹@m.SellingPrice.ToString("N2")</td><td><span class="badge @(m.Quantity<=10?"badge-amber":"badge-green")">@m.Quantity units</span></td><td>@m.ExpiryDate.ToString("dd MMM yyyy")</td><td><span class="badge @(m.ExpiryDate.Date<DateTime.Today?"badge-red":m.ExpiryDate.Date<=DateTime.Today.AddDays(60)?"badge-amber":"badge-blue")">@(m.ExpiryDate.Date<DateTime.Today?"Expired":m.ExpiryDate.Date<=DateTime.Today.AddDays(60)?"Expiring soon":m.Quantity<=10?"Low stock":"In stock")</span></td><td class="row-actions">@if(User.IsInRole("Admin")||User.IsInRole("Pharmacist")){<a asp-action="Edit" asp-route-id="@m.Id">Details / Edit</a><form asp-action="Delete" asp-route-id="@m.Id" method="post" onsubmit="return confirm('Delete this medicine batch?')"><button class="danger-link">Delete</button>@Html.AntiForgeryToken()</form>}</td></tr>}@if(Model.Items.Count==0){<tr><td colspan="8" class="empty-table">No medicine batches match these filters.</td></tr>}</tbody></table></div><div class="pager">@if(Model.Page>1){<a class="button button-light" asp-route-page="@(Model.Page-1)" asp-route-q="@Model.Search" asp-route-categoryId="@Model.CategoryId" asp-route-manufacturer="@Model.Manufacturer" asp-route-expiryBefore="@Model.ExpiryBefore?.ToString("yyyy-MM-dd")" asp-route-sort="@Model.Sort">← Previous</a>}@if(Model.Page<Model.TotalPages){<a class="button button-light" asp-route-page="@(Model.Page+1)" asp-route-q="@Model.Search" asp-route-categoryId="@Model.CategoryId" asp-route-manufacturer="@Model.Manufacturer" asp-route-expiryBefore="@Model.ExpiryBefore?.ToString("yyyy-MM-dd")" asp-route-sort="@Model.Sort">Next →</a>}</div></section>
