@model MedStore.Models.Medicine
@{ ViewData["Title"]=Model.Id==0?"Add medicine":"Edit medicine"; }
<div class="welcome-row"><div><h2>@ViewData["Title"]</h2><p>Enter product, batch, and stock details.</p></div><a class="button button-light" asp-action="Index">← Back to inventory</a></div><section class="panel form-panel"><form asp-action="Save" method="post"><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="form-error"></div><div class="form-grid"><div><label asp-for="Name">Medicine name</label><input asp-for="Name" placeholder="e.g. Paracetamol 500 mg"/><span asp-validation-for="Name" class="field-error"></span></div><div><label asp-for="CategoryId">Category</label><select asp-for="CategoryId"><option value="">Select category</option>@foreach(var c in (List<(int Id,string Name)>)ViewBag.Categories){<option value="@c.Id">@c.Name</option>}</select><span asp-validation-for="CategoryId" class="field-error"></span></div><div><label asp-for="Manufacturer"></label><input asp-for="Manufacturer"/></div><div><label asp-for="BatchNumber">Batch number</label><input asp-for="BatchNumber"/></div><div><label asp-for="SupplierId">Supplier ID</label><input asp-for="SupplierId" type="number"/></div><div><label asp-for="ExpiryDate">Expiry date</label><input asp-for="ExpiryDate" type="date"/></div><div><label asp-for="PurchasePrice">Purchase price (₹)</label><input asp-for="PurchasePrice" type="number" step="0.01"/></div><div><label asp-for="SellingPrice">Selling price (₹)</label><input asp-for="SellingPrice" type="number" step="0.01"/></div><div><label asp-for="Quantity">Opening quantity</label><input asp-for="Quantity" type="number"/></div><div class="wide-field"><label asp-for="Description"></label><textarea asp-for="Description" rows="3"></textarea></div></div><div class="form-actions"><a class="button button-light" asp-action="Index">Cancel</a><button class="button button-primary">Save medicine</button></div></form></section>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
