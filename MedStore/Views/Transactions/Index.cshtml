@model MedStore.Models.TransactionPageViewModel
@{var purchase=Model.Kind=="purchase";ViewData["Title"]=purchase?"Purchase management":"Sales & billing";}
<div class="welcome-row"><div><h2>@ViewData["Title"]</h2><p>@(purchase?"Record supplier purchases and replenish stock.":"Build customer bills and manage sales.")</p></div></div>@if(TempData["Notice"] is string n){<div class="notice">✓ @n</div>}@if(TempData["Error"] is string e){<div class="form-error notice-error">@e</div>}
<section class="panel transaction-panel"><div class="panel-head"><div><h3>@(purchase?"New purchase":"New sale")</h3><p>Stock updates only after a valid save.</p></div></div><form asp-action="Create" asp-route-kind="@Model.Kind" method="post" id="transaction-form">@Html.AntiForgeryToken()<div class="form-grid"><div><label>@(purchase?"Supplier":"Customer")</label><select name="PartnerId"><option value="">@(purchase?"Choose supplier":"Walk-in customer")</option>@foreach(var p in Model.Partners){<option value="@p.Id">@p.Name</option>}</select></div>@if(!purchase){<div><label>Discount (₹)</label><input type="number" step="0.01" min="0" name="Discount" value="0"/></div>}</div><div id="transaction-lines">@for(var i=0;i<1;i++){<div class="transaction-line"><select name="Lines[@i].MedicineId" required><option value="">Choose medicine batch</option>@foreach(var m in Model.Medicines){<option value="@m.Id" data-price="@(purchase?m.PurchasePrice:m.SellingPrice)">@m.Name · @m.BatchNumber · stock @m.Quantity · ₹@(purchase?m.PurchasePrice:m.SellingPrice)</option>}</select><input name="Lines[@i].Quantity" type="number" min="1" value="1" required/><button type="button" class="button button-light" onclick="removeTransactionLine(this)">Remove</button></div>}</div><div class="cart-summary"><span>Subtotal <strong id="cart-subtotal">₹0.00</strong></span><span>Discount <strong id="cart-discount">₹0.00</strong></span><span>Final amount <strong id="cart-total">₹0.00</strong></span></div><button type="button" class="button button-light" onclick="addTransactionLine()">＋ Add item</button><button class="button button-primary">Save @(purchase?"purchase":"sale")</button></form></section>
<section class="panel transaction-history"><div class="panel-head"><div><h3>@(purchase?"Purchase history":"Sales history")</h3><p>@Model.Transactions.Count transactions</p></div><button class="button button-light" onclick="window.print()">Print</button></div><form method="get" class="search-form transaction-search"><input type="hidden" name="kind" value="@Model.Kind"/><input name="q" value="@ViewBag.Search" placeholder="Search invoice or customer"/><button class="button button-light">Search</button></form><div class="table-wrap"><table><thead><tr><th>INVOICE</th><th>DATE</th><th>@(purchase?"SUPPLIER":"CUSTOMER")</th><th>ITEMS</th><th>TOTAL</th><th>STATUS</th><th></th></tr></thead><tbody>@foreach(var t in Model.Transactions){<tr><td><a asp-action="Invoice" asp-route-kind="@Model.Kind" asp-route-id="@t.Id"><strong>@t.InvoiceNumber</strong></a></td><td>@t.Date.ToString("dd MMM yyyy HH:mm")</td><td>@t.PartnerName</td><td>@string.Join(", ",t.Lines.Select(l=>$"{l.MedicineName} × {l.Quantity}"))</td><td>₹@t.Total.ToString("N2")</td><td><span class="badge @(t.Status=="Completed"?"badge-green":"badge-red")">@t.Status</span></td><td>@if(!purchase&&t.Status=="Completed"&&(User.IsInRole("Admin")||User.IsInRole("Pharmacist"))){<form asp-action="Cancel" asp-route-id="@t.Id" method="post" onsubmit="return confirm('Cancel this sale and return stock?')"><button class="danger-link">Cancel sale</button>@Html.AntiForgeryToken()</form>}</td></tr>}@if(Model.Transactions.Count==0){<tr><td colspan="7" class="empty-table">No transactions yet.</td></tr>}</tbody></table></div></section>
