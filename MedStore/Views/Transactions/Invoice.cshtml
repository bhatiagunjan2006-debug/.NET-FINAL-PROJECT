@model MedStore.Models.InvoiceViewModel
@{ViewData["Title"]="Invoice · "+Model.Transaction.InvoiceNumber;var t=Model.Transaction;}
<div class="welcome-row no-print"><div><h2>@(Model.IsPurchase?"Purchase invoice":"Sales invoice")</h2><p>@t.InvoiceNumber</p></div><button class="button button-primary" onclick="window.print()">Print invoice</button></div><article class="invoice-sheet"><header class="invoice-header"><div><div class="invoice-brand">✚ @Model.StoreName</div><p>@Model.StoreAddress<br/>@Model.StoreContact @if(!string.IsNullOrWhiteSpace(Model.StoreEmail)){<br/>@Model.StoreEmail}</p></div><div class="invoice-meta"><span>@(Model.IsPurchase?"PURCHASE":"TAX / SALES") INVOICE</span><strong>@t.InvoiceNumber</strong><small>@t.Date.ToString("dd MMMM yyyy · HH:mm")</small><span class="badge @(t.Status=="Completed"?"badge-green":"badge-red")">@t.Status</span></div></header><div class="invoice-partner"><div><small>@(Model.IsPurchase?"SUPPLIER":"BILLED TO")</small><strong>@t.PartnerName</strong>@if(!string.IsNullOrWhiteSpace(t.PartnerContact)){<span>@t.PartnerContact</span>}@if(!string.IsNullOrWhiteSpace(t.PartnerAddress)){<span>@t.PartnerAddress</span>}</div><div><small>INVOICE DATE</small><strong>@t.Date.ToString("dd MMM yyyy")</strong></div></div><table><thead><tr><th>#</th><th>MEDICINE</th><th>BATCH</th><th>QTY</th><th>UNIT PRICE</th><th>AMOUNT</th></tr></thead><tbody>@for(var i=0;i<t.Lines.Count;i++){var l=t.Lines[i];<tr><td>@(i+1)</td><td><strong>@l.MedicineName</strong></td><td>@l.BatchNumber</td><td>@l.Quantity</td><td>₹@l.UnitPrice.ToString("N2")</td><td>₹@l.Total.ToString("N2")</td></tr>}</tbody></table><div class="invoice-totals"><div><span>Subtotal</span><strong>₹@t.Subtotal.ToString("N2")</strong></div>@if(!Model.IsPurchase){<div><span>Discount</span><strong>− ₹@t.Discount.ToString("N2")</strong></div>}<div class="invoice-grand"><span>Total amount</span><strong>₹@t.Total.ToString("N2")</strong></div></div><footer class="invoice-footer">@(Model.IsPurchase?"Purchase recorded in store inventory.":"Thank you for choosing us. Please follow your doctor's instructions.")</footer></article>
