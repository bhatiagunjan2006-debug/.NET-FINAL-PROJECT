@model MedStore.Models.LoginViewModel
@{ ViewData["Title"]="Login"; Layout="_Layout"; }
<div class="login-page"><div class="login-art"><div class="art-grid"></div><div class="art-brand"><span class="brand-icon">✚</span><span>Medi<span class="brand-accent">Stock</span></span></div><div class="art-copy"><div class="art-pill"><i></i> SMART PHARMACY MANAGEMENT</div><h1>Care that’s<br/>always <em>in stock.</em></h1><p>One clear view of your inventory, sales, and store operations.</p><div class="art-pillars"><span>✚ &nbsp; Better organized</span><span>↗ &nbsp; Data you can trust</span></div></div><div class="art-footer">MEDISTOCK · STORE OPERATIONS</div><div class="floating-cross cross-one">✚</div><div class="floating-cross cross-two">✚</div></div><div class="login-side"><div class="login-box"><div class="mobile-brand"><span class="brand-icon">✚</span> MediStock</div><div class="login-kicker">WELCOME BACK</div><h2>Login to your store</h2><p class="login-subtitle">Use your staff account to continue.</p><form method="post" asp-controller="Account" asp-action="Login"><div asp-validation-summary="ModelOnly" class="form-error"></div><input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl"/><label asp-for="Username">Username</label><div class="input-wrap"><span>♙</span><input asp-for="Username" placeholder="Enter your username" autocomplete="username"/></div><span asp-validation-for="Username" class="field-error"></span><label asp-for="Password">Password</label><div class="input-wrap"><span>◈</span><input asp-for="Password" placeholder="Enter your password" autocomplete="current-password"/><button class="show-password" type="button" onclick="togglePassword()">Show</button></div><span asp-validation-for="Password" class="field-error"></span><div class="login-options"><label class="check-label"><input asp-for="RememberMe"/> <span>Remember me</span></label><a href="/Account/ForgotPassword" class="muted-link" title="Ask your store administrator to reset your password">Forgot password?</a></div><button class="button button-primary sign-in" type="submit">Login <span>→</span></button></form><div class="login-security"><span>♧</span> Protected access · Secure staff login</div></div><div class="login-copyright">© @DateTime.Now.Year MediStock · For authorized staff only</div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }
